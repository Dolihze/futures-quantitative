{
  "productName": "期货量化交易系统",
  "version": "1.0.0",
  "identifier": "com.futures-quantitative.app",
  "build": {
    "beforeDevCommand": "node scripts/dev-frontend.mjs",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar/python-backend"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "期货量化交易系统",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
