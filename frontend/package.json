{
  "name": "futures-quantitative-frontend",
  "version": "1.0.0",
  "description": "期货量化交易系统前端 - Vue3 + Element Plus",
  "type": "module",
  "scripts": {
    "predev": "npm run api:types",
    "dev": "vite",
    "prebuild": "npm run api:types",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run api:types",
    "typecheck": "vue-tsc --noEmit -p jsconfig.json",
    "api:types": "openapi-typescript ../openapi.json -o types/generated/api.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.6.0",
    "echarts": "^5.4.3",
    "element-plus": "^2.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.0",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.2.12"
  }
}
