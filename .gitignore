# Tauri
src-tauri/target/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# 构建产物
# 构建脚本（scripts/build-backend.mjs）的中间产物
.build/

# 打包后的 Python 后端（onedir，由 `npm run backend:build` 生成）
src-tauri/backend-dist/*
# 保留占位文件：Tauri 编译期要求 resources 目录存在，否则全新克隆后 cargo check 就会失败
!src-tauri/backend-dist/.gitkeep

# 依赖
/node_modules/
frontend/node_modules/

# CTP 真实期货公司接入参数（含认证码，不提交）
data/ctp_brokers.local.json

# 用户导入的个人数据（不提交）
review_files/
depth_files/

# Frontend
frontend/dist/
frontend/.vite/
# 由 unplugin-auto-import / unplugin-vue-components 生成
frontend/types/generated/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
