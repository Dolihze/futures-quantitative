{
  "name": "futures-quantitative",
  "version": "1.0.0",
  "description": "期货量化交易系统 - Tauri 2.x",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "tauri": "tauri",
    "setup": "node scripts/setup.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "backend:dev": "python backend/app.py",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "backend:build": "node scripts/build-backend.mjs",
    "api:types": "python scripts/gen_openapi.py && npm run --prefix frontend api:types",
    "api:check": "python scripts/gen_openapi.py openapi.check.json && node scripts/check-openapi.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
